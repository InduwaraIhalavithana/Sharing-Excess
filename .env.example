# Used by docker-compose.yml. Copy to .env (never commit it) and fill in.

# Database password for the bundled Postgres container
POSTGRES_PASSWORD=

# JWT signing key - 32+ random characters.
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Public address of the site - used for CORS and for links in emails.
# Local Docker run: http://localhost.  Real deployment: https://your-domain
CORS_ORIGIN=http://localhost

# Optional: Gmail app password for notification emails (leave blank to disable email)
MAIL_USERNAME=
MAIL_PASSWORD=

# Optional: Cloudinary for photo storage (leave blank to keep photos in the uploads volume)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
