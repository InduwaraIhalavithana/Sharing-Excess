# Used by docker-compose.yml. Copy to .env (never commit it) and fill in.

# Database password for the bundled Postgres container
POSTGRES_PASSWORD=

# JWT signing key - 32+ random characters.
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Public address of the site - used for CORS and for links in emails.
# Local Docker run: http://localhost.  Real deployment: https://your-domain
CORS_ORIGIN=http://localhost

# Gmail address + app password. REQUIRED for a real site: sign-up verification codes, password resets,
# the contact form and notification emails are all sent from here (without it nobody can sign up).
MAIL_USERNAME=
MAIL_PASSWORD=

# Optional: Cloudinary for photo storage (leave blank to keep photos in the uploads volume)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
