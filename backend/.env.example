# Copy this file to .env and fill in your values.

# JWT signing key - 32+ random characters, the app refuses to start without it.
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# PostgreSQL connection
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/sharing_excess

# CORS — frontend origin
CORS_ORIGIN=http://localhost:5175

# SMTP email (Gmail App Password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM_NAME=Sharing Excess
